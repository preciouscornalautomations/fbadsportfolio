# Copy this file to .env and fill it in. Restart `npm run dev` after changing it.

# The Web app URL you get after deploying apps-script/Code.gs (ends with /exec).
# Leave empty to make the form open the visitor's email app instead.
VITE_LEAD_ENDPOINT=

# Optional. Must match SECRET in apps-script/Code.gs. Light spam protection only,
# because anything in a front-end build is visible to visitors.
VITE_LEAD_TOKEN=
